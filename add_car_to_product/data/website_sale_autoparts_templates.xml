<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="autoparts_filter_shop" inherit_id="website_sale.products">
        <xpath expr="//div[@id='products_grid']" position="before">
            <t t-set="selected_brand" t-value="request.params.get('brand_id')"/>
            <t t-set="selected_model" t-value="request.params.get('model_id')"/>
            <t t-set="selected_year" t-value="request.params.get('year')"/>
            <t t-set="selected_volume" t-value="request.params.get('volume_id')"/>
            <t t-set="model_domain" t-value="selected_brand and [('brand_id', '=', int(selected_brand))] or []"/>

            <form action="/shop" method="get" class="mb-3">
                <div class="row g-2">
                    <div class="col-md-3">
                        <select name="brand_id" class="form-select" onchange="this.form.submit()">
                            <option value="">Manufacturer</option>
                            <t t-foreach="request.env['fleet.vehicle.model.brand'].sudo().search([])" t-as="brand">
                                <option
                                    t-att-value="brand.id"
                                    t-att-selected="str(brand.id) == selected_brand and 'selected' or None">>
                                    <t t-esc="brand.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <t t-set="selected_brand" t-value="request.params.get('brand_id')"/>
                        <t t-set="model_domain"
                           t-value="selected_brand and [('brand_id', '=', int(selected_brand))] or []"/>

                        <select name="model_id" class="form-select">
                            <option value="">Model name</option>
                            <t t-foreach="request.env['fleet.vehicle.model'].sudo().search(model_domain)"
                               t-as="vehicle_model">
                                <option
                                    t-att-value="vehicle_model.id"
                                    t-att-selected="str(vehicle_model.id) == selected_model and 'selected' or None">
                                    <t t-esc="vehicle_model.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <input type="number" name="year" class="form-control" placeholder="Year"/>
                    </div>

                    <div class="col-md-2">
                        <select name="volume_id" class="form-select">
                            <option value="">Volume</option>
                            <t t-foreach="request.env['fleet.vehicle.volume'].sudo().search([])" t-as="volume">
                                <option
                                    t-att-value="volume.id"
                                    t-att-selected="str(volume.id) == selected_volume and 'selected' or None">
                                    <t t-esc="volume.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </xpath>
    </template>
</odoo>