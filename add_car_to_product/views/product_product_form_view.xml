<odoo>
    <record id="product_product_form_inherit_autoparts" model="ir.ui.view">
        <field name="name">product.product.form.inherit.autoparts</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="name" position="after">
                <field name="variant_autopart_name" readonly="1"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Autoparts" name="autoparts"
                      invisible="not is_autoparts">
                    <!-- groups="add_car_to_product.group_car" -->

                    <group>
                        <field name="for_all_models"/>
                        <field name="oem"/>
                    </group>
                    <field name="compatible_vehicle_ids">Compatible vehicles</field>
                </page>
             </xpath>
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="is_autoparts"/>
                <field name="ovoko_part_id"/>
            </xpath>
        </field>
    </record>
</odoo>