<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fleet_vehicle_model_form_inherit" model="ir.ui.view">
    <field name="name">fleet.vehicle.model.form.inherit.autoparts</field>
    <field name="model">fleet.vehicle.model</field>

    <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>

    <field name="arch" type="xml">

        <xpath expr="//field[@name='name']" position="after">
            <field name="model_year_from"/>
            <field name="model_year_to"/>
        </xpath>

        <xpath expr="//field[@name='name']" position="after">
            <field name="model_type"/>
        </xpath>

        <xpath expr="//field[@name='name']" position="after">
            <field name="volume"/>
            <field name="ovoko_car_id"/>
        </xpath>

    </field>
</record>
</odoo>